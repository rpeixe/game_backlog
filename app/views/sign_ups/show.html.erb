<div class="flex items-center justify-center min-h-[70vh]">
  <div class="bg-white shadow rounded-lg p-8 w-full max-w-md">
    <h1 class="text-2xl font-bold mb-6 text-center">
      Sign Up
    </h1>

    <%= form_with model: @user, url: sign_up_path do |form| %>
      <%# Errors %>
      <% if form.object.errors.any? %>
        <div class="bg-red-100 text-red-700 p-3 mb-4 rounded">
          Error: <%= form.object.errors.full_messages.first %>
        </div>
      <% end %>

      <%# Email %>
      <div class="mb-4">
        <%= form.label :email, class: "block text-sm font-medium mb-1" %>
        <%= form.email_field :email_address,
          required: true,
          autofocus: true,
          autocomplete: "email",
          placeholder: "Enter your email address",
          class: "w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <%# Password %>
      <div class="mb-4">
        <%= form.label :password, class: "block text-sm font-medium mb-1" %>
        <%= form.password_field :password,
            required: true,
            autocomplete: "new-password",
            placeholder: "Enter your new password",
            maxlength: 72,
            class: "w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <%# Password confirmation %>
      <div class="mb-6">
        <%= form.label :password_confirmation, class: "block text-sm font-medium mb-1" %>
        <%= form.password_field :password_confirmation,
            required: true,
            autocomplete: "new-password",
            placeholder: "Repeat your new password",
            maxlength: 72,
            class: "w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <%# Submit %>
      <div>
        <%= form.submit "Sign up", class: "w-full bg-blue-500 text-white py-2 rounded hover:bg-blue-600" %>
      </div>
    <% end %>
  </div>
</div>
