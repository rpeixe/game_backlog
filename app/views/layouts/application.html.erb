<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Game Backlog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Game Backlog">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100 text-gray-900">

    <%# Navbar %>
    <nav class="bg-white shadow mb-6">
      <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">

        <%# Left side %>
        <div class="flex items-center gap-6">
          <%= link_to "GameBacklog", root_path, class: "text-xl font-bold text-blue-600" %>
          <%= link_to "Search", games_search_path, class: "text-gray-700 hover:text-blue-600" %>
        </div>

        <%# Right side %>
        <div class="flex items-center gap-4">
          <% if authenticated? %>
            <span class="text-gray-600 text-sm">
              <%= Current.user.email_address %>
            </span>

            <%= link_to "My Backlog", backlog_entries_path,
                class: "text-gray-700 hover:text-blue-600" %>

            <%= button_to "Log Out",
                session_path,
                method: :delete,
                class: "bg-red-500 text-white px-3 py-1 rounded hover:bg-red-600" %>
          <% else %>
            <%= link_to "Login",
                new_session_path,
                class: "bg-blue-500 text-white px-3 py-1 rounded hover:bg-blue-600" %>

            <%= link_to "Sign up",
                sign_up_path,
                class: "border border-blue-500 text-blue-500 px-3 py-1 rounded hover:bg-blue-50" %>
          <% end %>
        </div>
      </div>
    </nav>

    <%# Flash messages %>
    <div class="max-w-7xl mx-auto px-4">
      <% if notice %>
        <div class="bg-green-100 text-green-700 p-3 mb-4 rounded">
          <%= notice %>
        </div>
      <% end %>

      <% if alert %>
        <div class="bg-red-100 text-red-700 p-3 mb-4 rounded">
          <%= alert %>
        </div>
      <% end %>
    </div>

    <%# Main content %>
    <main class="max-w-7xl mx-auto px-4">
      <%= yield %>
    </main>
  </body>
</html>
