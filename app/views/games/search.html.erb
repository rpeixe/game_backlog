<h1>Search Games</h1>

<%= form_with url: games_search_path, method: :get, local: :true do |f| %>
  <%= f.text_field :query, placeholder: "Search for a game..." %>
  <%= f.submit "Search" %>
<% end %>

<% @games.each do |game| %>
  <div>
    <h3><%= game.name %></h3>

    <% if game.image_url.present? %>
      <img src="<%= game.image_url %>" alt="<%= game.name %>'s image" width="150">
    <% end %>

    <p>Cheapest price: $<%= game.cheapest_price %></p>
  </div>
<% end %>
